<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SimpleCalculator" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="CalcButton" parent="@android:style/Widget.Material.Button">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@drawable/bg_button_number</item>
    </style>

    <style name="CalcButton.Utility">
        <item name="android:textSize">23sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">@drawable/bg_button_utility</item>
    </style>

    <style name="CalcButton.Operator">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/operator_text</item>
        <item name="android:background">@drawable/bg_button_operator</item>
    </style>

    <style name="CalcButton.Equals">
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/accent_text</item>
        <item name="android:background">@drawable/bg_button_accent</item>
    </style>
</resources>
